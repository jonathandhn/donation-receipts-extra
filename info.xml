<?xml version="1.0"?>
<extension key="com.ixiam.modules.donrecextra" type="module">
  <file>donrecextra</file>
  <name>Donation Receipts Extra</name>
  <description>Extends Donation Receipts with portable tokens, headless generation, CiviRules automation, and receipt auditing.</description>
  <license>AGPL-3.0</license>
  <maintainer>
    <author>Jonathan Dahan</author>
    <email>jonathan@dhn.one</email>
  </maintainer>
  <releaseDate>2026-06-22</releaseDate>
  <version>1.1.3</version>
  <develStage>stable</develStage>
  <compatibility>
    <ver>6.14</ver>
  </compatibility>
  <comments>Originally developed by iXiam Global Solutions. Currently developed and maintained by Jonathan Dahan.</comments>
  <civix>
    <namespace>CRM/Donrecextra</namespace>
    <format>23.02.1</format>
  </civix>
  <requires>
    <ext>de.systopia.donrec</ext>
  </requires>
  <mixins>
    <mixin>scan-classes@1.0.0</mixin>
    <mixin>menu-xml@1.0.0</mixin>
    <mixin>smarty-v2@1.0.1</mixin>
  </mixins>
  <classloader>
    <psr0 prefix="CRM_" path="."/>
    <psr4 prefix="Civi\" path="Civi"/>
  </classloader>
  <upgrader>CRM_Donrecextra_Upgrader</upgrader>
</extension>
